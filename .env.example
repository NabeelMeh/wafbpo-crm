# Copy to .env.local; never commit actual credentials.
# EXISTING INSTALL: retain the exact database name and BOTH original keys.
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=wafbpo_crm
DATA_ENCRYPTION_KEY=
SEARCH_HMAC_KEY=
# Two DIFFERENT base64-encoded 32-byte keys. Generate only for a NEW EMPTY database.
# Do not replace keys in an existing installation.

# First-admin bootstrap ONLY for a new database; remove these after use.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
# Use true in production. Enroll privileged MFA before processing lead data.
REQUIRE_PRIVILEGED_MFA=true

# Server-only email recipient fallback. Management/Admin may override in Settings.
# Never use NEXT_PUBLIC_ for any email/security setting.
SECURITY_EMAIL=cloudnestbpo@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP uses authenticated TLS: port 465 or STARTTLS port 587.
# These are service credentials, NOT a user's CRM password.

# Optional low-latency realtime; authenticated polling is the fallback.
ABLY_API_KEY=
REPORT_TIMEZONE=Asia/Karachi

# Private versioned S3. Prefer workload credentials; static keys may be omitted
# only where the AWS SDK default credential provider has an authorized identity.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_ENDPOINT=
# S3_ENDPOINT is optional; alternative services need explicit compatibility tests.

# Controlled rollout only. Stop old application/worker writers as well.
MAINTENANCE_MODE=false
MIGRATION_BACKUP_CONFIRMED=no
