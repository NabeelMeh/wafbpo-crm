{
  "name": "cloud-nest-bpo-crm",
  "version": "0.3.0-rc.1",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:indexes": "tsx --env-file=.env.local scripts/indexes.ts",
    "db:admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "test:integration": "tsx --env-file=.env.test tests/integration.ts",
    "worker:scan": "tsx --env-file=.env.local scripts/scan-files.ts",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "env:check": "node --env-file=.env.local scripts/check-env.mjs",
    "test:types": "tsc -p tsconfig.core.json",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate-cloudnest.ts",
    "worker:purge": "tsx --env-file=.env.local scripts/purge-files.ts",
    "release:check": "npm run test && npm run typecheck && npm run build",
    "env:check:production": "node --env-file=.env.local scripts/check-env.mjs --production",
    "check:source": "node scripts/check-source.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-presigned-post": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "ably": "^2.14.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "next": "^16.3.8",
    "nodemailer": "^10.1.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.4",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
