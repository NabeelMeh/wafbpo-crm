# Copy to .env.local. Never commit actual secrets.
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=wafbpo_crm
# Each key is a DIFFERENT 32-byte random value, base64 encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
SEARCH_HMAC_KEY=
# Used ONLY by the one-time CLI. Remove after creating the first administrator.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
# Set true in production. Privileged users must enroll before accessing lead data.
REQUIRE_PRIVILEGED_MFA=false
# Optional managed realtime. Without it, authenticated polling runs every 10 seconds.
ABLY_API_KEY=
# Optional private S3 uploads. Bucket VERSIONING and block-public-access are required.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional S3-compatible endpoint. Must implement versioning + presigned POST.
S3_ENDPOINT=
# At least 32 random characters. Required for quarantine scanning worker.
FILE_SCAN_SECRET=
# Scanner worker only. Install ClamAV / clamscan; run outside Vercel.
SCANNER_APP_URL=http://localhost:3000
CLAMSCAN_PATH=clamscan
