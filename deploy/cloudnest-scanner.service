[Unit]
Description=Cloud Nest quarantine scanner (one bounded invocation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cloudnest
Group=cloudnest
WorkingDirectory=/opt/cloud-nest-bpo-crm
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Use absolute Node/npm paths matching your installation. Restrict .env.local permissions.
ExecStart=/usr/bin/npm run worker:scan
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
